## Data Path Configurations
PHENOTYPES_JSON_PATH=/data/phenotype_library.json
RAW_DUCKDB_PATH=data/mimiciv_omop.duckdb

# Written by generate_cohorts.R, read by build_sketches.py
COHORT_DUCKDB_PATH=data/cohorts.duckdb

OUTPUT_DIR=outputs/

## Phenotype Library Parameters
MAX_PHENOTYPES=

## Liquid Legions sketch parameters
# Per-sketch privacy budget. Total budget across K cohorts composes as K·ε
# under basic composition; tighten with a zCDP / RDP accountant for deployment.
LL_EPSILON=2.0
# Number of registers per sketch (more = lower variance, linear bandwidth cost)
LL_M=50000
# Truncated-exponential decay. Tune to your cohort size distribution.
LL_A=10.0